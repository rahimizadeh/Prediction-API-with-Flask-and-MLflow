# MLflow Configuration
mlflow:
  tracking_uri: "http://127.0.0.1:8080"
  experiment_name: "SalaryPrediction"
  registered_model_name: "SalaryRandomForest"
  model_alias: "champion"

# Flask Server Configuration
flask:
  host: "0.0.0.0"
  port: 5001
  debug: false

# Model Configuration
model:
  n_estimators: 200
  random_state: 42
  features: ["experience", "age", "interview_score"]
  target: "Salary"

# Path Configuration
paths:
  data: "./Salary_predict.csv"
